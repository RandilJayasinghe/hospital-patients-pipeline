# =============================================================================
# EC8203 Applied Big Data Engineering -- Hospital Vital Signs Lambda Pipeline
# Copy this file to .env (`cp .env.example .env`) before `docker compose up`.
# Every tunable in the system is read from here via config/settings.py; there
# are no magic numbers elsewhere in the codebase.
# =============================================================================

# ---- Simulated clock -------------------------------------------------------
# 1 simulated day = SIM_DAY_SECONDS real seconds (300 s = 5 real minutes).
# If you change this, also update the LabFileMissing / BatchLate thresholds in
# observability/alerts.yml (Prometheus rule files cannot read env vars).
SIM_DAY_SECONDS=300
SIM_START_DATE=2026-01-01

# ---- Ingestion --------------------------------------------------------------
NUM_PATIENTS=18
VITALS_INTERVAL_SECONDS=2
# Per patient, per tick (VITALS_INTERVAL_SECONDS). 0.002 => ~26% of patients
# start an anomaly episode in a given 5-minute simulated day (150 ticks).
ANOMALY_PROBABILITY=0.002
DIRTY_DATA_RATE=0.02
MALFORMED_RATE=0.005
LATE_EVENT_RATE=0.01
LATE_EVENT_MAX_DELAY_SECONDS=40

# ---- Kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_INTERNAL=kafka:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:29092
KAFKA_CLUSTER_ID=e1HBZ7LpS_q5zP3Zpcr3TQ
TOPIC_VITALS_RAW=vitals_raw
TOPIC_VITALS_RAW_PARTITIONS=3
TOPIC_LAB_BATCH=lab_batch
TOPIC_LAB_BATCH_PARTITIONS=1
TOPIC_VITALS_CLEAN=vitals_clean
TOPIC_VITALS_CLEAN_PARTITIONS=3
TOPIC_CLINICAL_ALERTS=clinical_alerts
TOPIC_CLINICAL_ALERTS_PARTITIONS=1
TOPIC_VITALS_DLQ=vitals_dlq
TOPIC_VITALS_DLQ_PARTITIONS=1

# ---- Postgres -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_VITALS=vitals
POSTGRES_DB_AIRFLOW=airflow

# ---- Spark streaming ------------------------------------------------------
STREAM_TRIGGER_SECONDS=30
STREAM_ALERT_TRIGGER_SECONDS=5
ALERT_COOLDOWN_SECONDS=60
STREAM_WATERMARK_SECONDS=45
WINDOW_DURATION_MINUTES=1
WINDOW_SLIDE_SECONDS=30
SPARK_SHUFFLE_PARTITIONS=4
SPARK_DRIVER_MEMORY=768m
SUSTAINED_ALERT_WINDOWS=2
MAX_OFFSETS_PER_TRIGGER=2000

# ---- Archiver (master dataset writer) --------------------------------------
ARCHIVER_TRIGGER_SECONDS=30

# ---- Airflow ----------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-prod

# ---- Serving API ------------------------------------------------------------
API_PORT=8000

# ---- Observability -----------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Host port for Grafana. Windows can reserve ranges such as 2921-3020 (Hyper-V/WinNAT);
# if `docker compose up` says port 3000 is "forbidden", set e.g. GRAFANA_HOST_PORT=3300.
GRAFANA_HOST_PORT=3000
NO_VITALS_ALERT_MINUTES=5
STREAM_STALLED_SECONDS=120
BATCH_LATE_MINUTES=12

# ---- Paths (inside containers; do not change unless you know why) ----------
DATA_ROOT=/data
LANDING_LABS_DIR=/data/landing/labs
MASTER_VITALS_DIR=/data/master/vitals
CHECKPOINT_STREAM_DIR=/data/checkpoints/stream
CHECKPOINT_ARCHIVER_DIR=/data/checkpoints/archiver
REPORTS_DIR=/data/reports
LOGS_DIR=/data/logs
QUARANTINE_DIR=/data/quarantine
